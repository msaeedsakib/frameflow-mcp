{
  "name": "@saeedsakib/frameflow-mcp",
  "version": "0.3.0",
  "description": "MCP server for Google's Nano Banana, Gemini Omni, Gemini TTS and Lyria models with a Gemini API key",
  "license": "MIT",
  "type": "module",
  "bin": {
    "frameflow-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msaeedsakib/frameflow-mcp.git"
  },
  "homepage": "https://github.com/msaeedsakib/frameflow-mcp#readme",
  "bugs": {
    "url": "https://github.com/msaeedsakib/frameflow-mcp/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "gemini",
    "nano-banana",
    "omni",
    "lyria",
    "image-generation",
    "video-generation",
    "text-to-speech",
    "music-generation",
    "claude",
    "cursor",
    "codex"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target node --packages external --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
